# Shared image for the api (python -m api) and the engine worker (python -m engine).
# docker-compose.yml picks the command per service.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/services/hl:/app/services/vault:/app/services/engine:/app/services/discovery:/app/services/api \
    COPYCAT_DATA_DIR=/data

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv

WORKDIR /app

# Dependencies first so code edits don't bust the layer.
COPY pyproject.toml ./
RUN uv pip install --system --no-cache -r pyproject.toml

COPY contracts ./contracts
COPY services/hl/hl ./services/hl/hl
COPY services/vault/vault ./services/vault/vault
COPY services/engine/engine ./services/engine/engine
COPY services/discovery/discovery ./services/discovery/discovery
COPY services/api/api ./services/api/api

# uid 1000 matches the usual first Linux user, so the ./data bind mount stays writable.
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin copycat \
    && mkdir -p /data && chown copycat:copycat /data
USER copycat

VOLUME ["/data"]
CMD ["python", "-m", "api"]
