              },
              {
                "type": "null"
              }
            ],
            "title": "Leader Overrides"
          },
          "leaders": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leaders"
          },
          "leverage": {
            "anyOf": [
              {
                "type": "integer"
              },
