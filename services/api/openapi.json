    "/api/engine/close-all": {
      "post": {
        "description": "Emergency flatten. Flips `enabled` false FIRST (so nothing new opens\neven before the engine sees the flag), then writes\n`data/close_all.flag`. The engine's next cycle closes every copy it\nopened, reduce-only, regardless of `dry_run`; positions copycat did not\nopen are never touched. Idempotent: a second call while one is pending\njust refreshes the timestamp.",
        "operationId": "close_all_api_engine_close_all_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloseAllResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Close All",
        "tags": [
          "engine"
        ]
      }
    },
    "/api/engine/halt": {
      "post": {
        "description": "Flips `enabled` false. Exits already open keep mirroring -- the\nengine, not the api, decides what \"halted\" means for open positions;\nthis route's only job is the settings flip.",
        "operationId": "halt_api_engine_halt_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Halt",
        "tags": [
          "engine"
        ]
      }
    },
